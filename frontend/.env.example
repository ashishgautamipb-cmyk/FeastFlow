# ==============================================================================
# FeastFlow Frontend — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your local or production setup.
# ==============================================================================

# Backend API Endpoint
# Local dev: http://localhost:5000
# Production: https://api.yourdomain.com
VITE_SERVER_URL=http://localhost:5000

# Geoapify Geocoding API Key (for Leaflet reverse geocoding & address search)
# Get a free key at: https://myprojects.geoapify.com/
VITE_GEOAPIKEY=your_geoapify_api_key

# Razorpay Client Public Key ID (must match backend RAZORPAY_KEY_ID)
# Get test keys from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Firebase Configuration (for Google OAuth Popup Login)
# Get from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup
VITE_FIREBASE_APIKEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
