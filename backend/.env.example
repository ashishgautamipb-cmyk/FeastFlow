# ==============================================================================
# FeastFlow Backend — Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with your real credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB URI)
# Local: mongodb://localhost:27017/feastflow
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/feastflow?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017/feastflow

# Security & Authentication
# Generate a strong 64-character random string in production
JWT_SECRET=feastflow_jwt_secret_key_change_in_production_2026

# Cloudinary (Media storage for restaurant covers & food dish photos)
# Sign up at https://cloudinary.com to get your credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer / Transactional Email (Password reset & delivery OTP delivery)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Razorpay Payment Gateway (Test or Live API Keys)
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Google Gemini AI (Smart AI Food Search & Intent Discovery)
# Generate a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
